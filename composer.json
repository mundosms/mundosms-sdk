    "license": "MIT",
    "keywords": ["mundosms", "sms", "whatsapp", "voip", "click2dial", "centralita", "api", "sdk"],
    "homepage": "https://www.mundosms.es/api-v3",
    "authors": [
        {
            "name": "MundoSMS",
            "homepage": "https://www.mundosms.es"
        }
    ],
    "support": {
        "docs": "https://www.mundosms.es/api-v3",
        "source": "https://github.com/mundosms/mundosms-sdk",
        "issues": "https://github.com/mundosms/mundosms-sdk/issues"
    },
    "require": {
        "php": ">=7.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "classmap": ["php/mundosms.php"]
    }
}
