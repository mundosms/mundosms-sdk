{
  "name": "@mundosms/sdk",
  "version": "1.2.0",
  "description": "Cliente de la API REST v3 de MundoSMS: SMS, WhatsApp, centralita, VozPush y NumCheck. Firma cada petición y reintenta solo lo que es seguro repetir. Sin dependencias.",
  "license": "MIT",
  "author": "MundoSMS (https://www.mundosms.es)",
  "homepage": "https://www.mundosms.es/api-v3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mundosms/mundosms-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mundosms/mundosms-sdk/issues"
  },
  "keywords": [
    "mundosms",
    "sms",
    "whatsapp",
    "voip",
    "click2dial",
    "centralita",
    "api",
    "sdk"
  ],
  "type": "commonjs",
  "main": "./mundosms.js",
  "types": "./mundosms.d.ts",
  "exports": {
    ".": {
      "types": "./mundosms.d.ts",
      "require": "./mundosms.js",
      "import": "./mundosms.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "mundosms.js",
    "mundosms.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
